rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    // True when the caller is signed in via Firebase Auth.
    function isAuth() {
      return request.auth != null;
    }

    // True when the Firebase Auth uid matches the document id (owner check).
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Read the caller's own Users/{uid} doc and return their role.
    // Used to gate admin-only paths without a second round-trip from the client.
    function callerRole() {
      return get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role;
    }

    // True when the caller is an Admin or MainAdmin. 'Admin' is the legacy
    // role name kept alongside 'CityManager' / 'ContentAdmin' (see
    // RbacService.normalizeRole) so accounts granted before the split still
    // pass this check.
    function isAdmin() {
      return isAuth() && callerRole() in ['Admin', 'CityManager', 'ContentAdmin', 'MainAdmin'];
    }

    // True when the caller is a MainAdmin only.
    function isMainAdmin() {
      return isAuth() && callerRole() == 'MainAdmin';
    }

    // The single place a plain 'Admin' is scoped to (see rbac_service.dart —
    // set on Users/{uid}.managedPlaceId when their AdminRequest is approved).
    function callerManagedPlaceId() {
      return get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.managedPlaceId;
    }

    // True when the caller is a place-scoped admin (legacy 'Admin',
    // 'CityManager', or 'ContentAdmin') scoped to exactly this place.
    // MainAdmin is intentionally NOT included here — callers should combine
    // this with isMainAdmin() explicitly, since MainAdmin's access isn't
    // place-scoped at all.
    function isPlaceAdminFor(placeId) {
      return isAuth()
        && callerRole() in ['Admin', 'CityManager', 'ContentAdmin']
        && callerManagedPlaceId() == placeId;
    }


    // ── Anonymous / authenticated session backup ──────────────────────────────
    //
    // Document key = Firebase Auth uid.
    // Only the owning user may read, write, or delete their own session doc.
    match /_pnrc_sessions/{uid} {
      allow read, write, delete:
        if isOwner(uid);
    }


    // ── User profiles ─────────────────────────────────────────────────────────
    //
    // Document key = Firebase Auth uid (set by FirebaseService._writeUserDocument).
    // Fields: email, role, createdAt, lastLoginAt, provider, mfaEnabled, …
    //
    // Access matrix:
    //   READ   — own document, OR any Admin/MainAdmin (needed by RbacService
    //            .getUserRole and .userRoleStream which read Users/{firebaseUid}).
    //   CREATE — owner only; role must be absent or exactly "Tourist".
    //   UPDATE — owner may update own doc but cannot change their role or
    //            managedPlaceId. Only MainAdmin may promote a role or assign
    //            a place — a plain 'Admin' has no reason to touch any Users
    //            doc (their own or anyone else's) beyond their own profile
    //            fields, so it's MainAdmin-only rather than isAdmin().
    //   DELETE — never from the client.
    match /Users/{uid} {

      allow read:
        if isOwner(uid) || isAdmin();

      allow create:
        if isOwner(uid)
        && (!('role' in request.resource.data)
            || request.resource.data.role == 'Tourist');

      allow update:
        if (isOwner(uid)
            && (!('role' in request.resource.data)
                || request.resource.data.role == resource.data.role)
            && (!('managedPlaceId' in request.resource.data)
                || request.resource.data.managedPlaceId == resource.data.managedPlaceId))
        || isMainAdmin();

      allow delete: if false;
    }


    // ── Admin Role Requests ───────────────────────────────────────────────────
    //
    // Collection: AdminRequests
    // Document fields written by RbacService.submitAdminRequest:
    //   firebaseUid      — Firebase Auth uid of the requester  ← identity anchor
    //   userId           — custom API id (stored for backend cross-reference)
    //   userEmail        — string
    //   facilityName     — string
    //   servicesOffered  — string[]
    //   agreedToTerms    — bool
    //   status           — 'pending' | 'accepted' | 'denied'
    //   createdAt        — timestamp
    //   (on update) grantedRole, denialReason, respondedAt, respondedBy, …
    //
    // Access matrix:
    //   READ   — the requester (firebaseUid == caller uid), OR MainAdmin.
    //   CREATE — authenticated user; firebaseUid must equal caller uid;
    //            status must start as 'pending'.
    //   UPDATE — MainAdmin only (approve / deny).
    //   DELETE — never from the client.
    match /AdminRequests/{requestId} {

      allow read:
        if isAuth()
        && (resource.data.firebaseUid == request.auth.uid || isMainAdmin());

      allow create:
        if isAuth()
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.placeId is string
        && request.resource.data.placeId.size() > 0;

      allow update:
        if isMainAdmin();

      allow delete: if false;
    }


    // ── Blog posts mirror ─────────────────────────────────────────────────────
    //
    // Any authenticated user may read.
    // Only Admin / MainAdmin may write.
    match /blog_posts/{slug} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }


    // ── Place supplementary details ───────────────────────────────────────────
    //
    // Collection: Place_details
    // Document key = the place's /api/places id (one doc per place).
    // Written by PlaceDetailsService: images attached to nested items (rooms,
    // menu items, shows) and, per-place, the accepted PaymentMethods ids.
    // Not part of the /api/places contract — stored here until the backend
    // is redesigned to accept it directly.
    //
    // PUBLIC read: the tourist app browses places (landing_page.dart →
    // resort_city_screen.dart → category_screen.dart → place_details_screen.dart)
    // entirely without signing in — this app has no anonymous Firebase Auth
    // session, so gating reads behind isAuth() would silently hide nested-item
    // photos and payment methods from every logged-out visitor. Write is
    // MainAdmin (any place) or a plain Admin scoped to exactly this place
    // (Place Admin Panel's Payment Methods / nested-item-photo tools).
    match /Place_details/{placeId} {
      allow read:  if true;
      allow write: if isMainAdmin() || isPlaceAdminFor(placeId);
    }


    // ── Accommodation / Dining catalog (Firestore-authoritative) ─────────────
    //
    // Collections: Rooms, MenuSections, MenuItems
    // Document id = auto-generated — this id is the catalog item's canonical
    // id from here on (what BookingModel.serviceId references).
    // Written by the admin place wizard (RoomService / MenuService); a
    // best-effort mirror is separately pushed to the backend REST API
    // (BackendRoomSync / BackendMenuSync) but Firestore is the source of
    // truth — see room_model.dart / menu_item_model.dart for field shapes.
    //
    // PUBLIC read for the same reason as Place_details above — the tourist
    // app browses the catalog without signing in. Write is MainAdmin (any
    // place) or a plain Admin scoped to exactly this item's place.
    match /Rooms/{roomId} {
      allow read:   if true;
      allow create: if isMainAdmin() || isPlaceAdminFor(request.resource.data.placeId);
      allow update, delete:
        if isMainAdmin() || isPlaceAdminFor(resource.data.placeId);
    }

    match /MenuSections/{sectionId} {
      allow read:   if true;
      allow create: if isMainAdmin() || isPlaceAdminFor(request.resource.data.placeId);
      allow update, delete:
        if isMainAdmin() || isPlaceAdminFor(resource.data.placeId);
    }

    match /MenuItems/{itemId} {
      allow read:   if true;
      allow create: if isMainAdmin() || isPlaceAdminFor(request.resource.data.placeId);
      allow update, delete:
        if isMainAdmin() || isPlaceAdminFor(resource.data.placeId);
    }


    // ── Payment methods catalogue ─────────────────────────────────────────────
    //
    // Collection: PaymentMethods
    // Document id = auto-generated.
    // Admin-managed list of payment options places can be configured to
    // accept (M-Pesa, Card, Bank Transfer, Cash, …). Configuration only —
    // no payment processing happens through this collection.
    //
    // PUBLIC read for the same reason as Place_details above. This is a
    // global, system-wide catalogue — only MainAdmin configures it; a
    // place-scoped Admin can only choose from it (via Place_details), not
    // add to it.
    match /PaymentMethods/{methodId} {
      allow read:  if true;
      allow write: if isMainAdmin();
    }


    // ── Resort city presentation config ───────────────────────────────────────
    //
    // Collection: City_details
    // Document key = the city's /api/cities id.
    // Featured flag + manual sort order used to order the tourist landing
    // page's city grid and the admin Resort Cities list. Not part of the
    // /api/cities contract.
    //
    // PUBLIC read for the same reason as Place_details above. Cities aren't
    // owned by any single place-scoped Admin, so only MainAdmin may write.
    match /City_details/{cityId} {
      allow read:  if true;
      allow write: if isMainAdmin();
    }


    // ── System-wide settings ──────────────────────────────────────────────────
    //
    // Collection: SystemSettings, single doc "main".
    // Fields: maintenanceMode, maintenanceMessage, updatedAt, updatedByEmail, …
    // (see SystemSettingsModel / SystemSettingsService).
    //
    // PUBLIC read: landing_page.dart subscribes to this doc unconditionally,
    // for every visitor including signed-out tourists, to show/hide the
    // maintenance banner — same public-read rationale as Place_details above.
    // Write is MainAdmin only.
    match /SystemSettings/{docId} {
      allow read:  if true;
      allow write: if isMainAdmin();
    }


    // ── Category presentation config ──────────────────────────────────────────
    //
    // Collection: CategoryDetails
    // Document key = the category's /api/categories id.
    // City/tag scoping used to filter which categories a resort city shows —
    // not part of the /api/categories contract (see category_details_service.dart).
    //
    // PUBLIC read: category_screen.dart / resort_city_screen.dart read this
    // while browsing, signed out. Write is MainAdmin only.
    match /CategoryDetails/{categoryId} {
      allow read:  if true;
      allow write: if isMainAdmin();
    }


    // ── Static content pages ────────────────────────────────────────────────
    //
    // Collection: StaticPages
    // Document key = a managed slug (about, privacy-policy, terms-of-service,
    // cookie-policy — see StaticPageService.managedSlugs).
    //
    // PUBLIC read: about_screen.dart / static_info_screen.dart read these
    // signed out. Write is MainAdmin only.
    match /StaticPages/{slug} {
      allow read:  if true;
      allow write: if isMainAdmin();
    }


    // ── In-app notifications ──────────────────────────────────────────────────
    //
    // Collection: Notifications
    // Document id = auto-generated. Written server-side only, by the
    // onBookingCreated / onBookingStatusChanged Cloud Functions (Admin SDK,
    // which bypasses these rules entirely) — alongside the FCM push those
    // functions already send, so a signed-in user also gets a persisted
    // bell/history entry. Fields: recipientUid, type
    // ('booking_created'|'booking_status_changed'), title, body, bookingId,
    // read (bool), createdAt.
    //
    // READ   — only the recipient.
    // UPDATE — only the recipient, and only to flip `read` (see BookingNotificationService.markRead).
    // CREATE/DELETE — never from the client; server-only via Admin SDK.
    match /Notifications/{notificationId} {
      allow read:
        if isAuth() && resource.data.recipientUid == request.auth.uid;

      allow update:
        if isAuth()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['read']);

      allow create, delete: if false;
    }


    // ── Bookings ───────────────────────────────────────────────────────────────
    //
    // Collection: Bookings
    // Document id = auto-generated.
    // Created by a signed-in tourist from PlaceDetailsScreen's "Book Now" flow
    // (see BookingService / booking_screen.dart). Fields:
    //   placeId, placeName, cityId, cityName   — snapshot of what was booked
    //   firebaseUid, userEmail                 — identity anchor (must match caller)
    //   serviceType, serviceName               — optional nested item (room/menu/show)
    //   requestedDate, checkOutDate            — Timestamps
    //   numberOfGuests, notes
    //   paymentMethodId, paymentMethodName      — snapshot of chosen PaymentMethods doc
    //   status                                 — 'pending' | 'awaitingPayment' |
    //                                             'paymentSubmitted' | 'confirmed' |
    //                                             'cancelled' | 'completed'
    //   bookingGroupId                          — links several docs from one
    //                                             multi-service checkout (optional)
    //   paymentProofText/paymentProofImageUrl/
    //   paymentRejectionReason                  — proof-based confirmation for
    //                                             non-M-Pesa methods (see
    //                                             PlacePaymentInstructions)
    //   createdAt, updatedAt
    //
    // Access matrix:
    //   READ   — the requester (firebaseUid == caller uid), MainAdmin, or a
    //            plain Admin scoped to this booking's place.
    //   CREATE — authenticated user; firebaseUid must equal caller uid;
    //            status must start as 'pending'.
    //   UPDATE — MainAdmin or the scoped place Admin (confirm/cancel/
    //            complete/approve-or-reject payment proof), unconditionally;
    //            OR the requester (a) submitting a payment proof while
    //            'awaitingPayment' (→ 'paymentSubmitted'), or (b) cancelling
    //            their own booking before it's confirmed.
    //   DELETE — never from the client.
    match /Bookings/{bookingId} {

      allow read:
        if isAuth()
        && (resource.data.firebaseUid == request.auth.uid
            || isMainAdmin()
            || isPlaceAdminFor(resource.data.placeId));

      allow create:
        if isAuth()
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.status == 'pending';

      // Cutoff before requestedDate under which a tourist may still cancel —
      // must mirror BookingModel.checkCancellationEligibility on the client.
      allow update:
        if isMainAdmin()
        || isPlaceAdminFor(resource.data.placeId)
        || (isAuth()
            && resource.data.firebaseUid == request.auth.uid
            && resource.data.status == 'awaitingPayment'
            && request.resource.data.status == 'paymentSubmitted')
        || (isAuth()
            && resource.data.firebaseUid == request.auth.uid
            && resource.data.status in ['pending', 'awaitingPayment', 'paymentSubmitted']
            && request.resource.data.status == 'cancelled'
            && request.time < resource.data.requestedDate - (
                 resource.data.cancellationPolicy == 'strict'   ? duration.value(7, 'd') :
                 resource.data.cancellationPolicy == 'moderate' ? duration.value(48, 'h') :
                 duration.value(0, 'h')
               ));

      allow delete: if false;

      // ── Two-way booking messages ──────────────────────────────────────
      //
      // Subcollection: Bookings/{bookingId}/messages/{messageId}
      // Fields: senderUid, senderRole ('tourist'|'admin'), text, createdAt.
      //
      // READ/CREATE — the booking's own tourist, or an admin scoped to its
      // place (or MainAdmin). Never updated/deleted — an append-only thread.
      match /messages/{messageId} {
        allow read, create:
          if isAuth()
          && (get(/databases/$(database)/documents/Bookings/$(bookingId)).data.firebaseUid == request.auth.uid
              || isMainAdmin()
              || isPlaceAdminFor(get(/databases/$(database)/documents/Bookings/$(bookingId)).data.placeId));

        allow update, delete: if false;
      }
    }


    // ── Place-specific payment instructions ───────────────────────────────────
    //
    // Collection: PlacePaymentInstructions
    // Document id = auto-generated.
    // A place's own account/till/paybill details for a payment method it
    // accepts — see place_payment_instruction_model.dart for why this is
    // separate from the global PaymentMethods catalogue.
    //
    // PUBLIC read: a tourist needs to see these during checkout, signed out
    // or in. Write is MainAdmin (any place) or a plain Admin scoped to
    // exactly this instruction's place.
    match /PlacePaymentInstructions/{instructionId} {
      allow read: if true;
      allow create: if isMainAdmin() || isPlaceAdminFor(request.resource.data.placeId);
      allow update, delete:
        if isMainAdmin() || isPlaceAdminFor(resource.data.placeId);
    }


    // ── Payment gateway transactions ──────────────────────────────────────────
    //
    // Collection: Transactions
    // Document id = client-generated (see MpesaService.newTransactionRef).
    // Written exclusively by the initiateMpesaPayment / mpesaCallback /
    // queryMpesaStatus Cloud Functions via the Admin SDK, which bypasses these
    // rules entirely — "write: if false" here just documents that no client
    // write path exists, it isn't what actually blocks the Cloud Functions.
    //
    // READ — the tourist who initiated the payment (firebaseUid match), or
    // MainAdmin (support/reconciliation). A place-scoped Admin has no
    // reconciliation role here — payments aren't yet linked to a placeId.
    match /Transactions/{transactionId} {
      allow read:
        if isAuth()
        && (resource.data.firebaseUid == request.auth.uid || isMainAdmin());

      allow write: if false;
    }


    // ── Place queries ─────────────────────────────────────────────────────────
    //
    // Collection: PlaceQueries
    // Document id = auto-generated.
    // A tourist's question about a place, answered by that place's Admin (or
    // MainAdmin) from the Place Admin Panel. Fields: placeId, placeName,
    // firebaseUid, userEmail, message, status ('open'|'answered'),
    // adminReply, repliedBy, createdAt, repliedAt.
    //
    // READ   — the tourist who asked (firebaseUid == caller), MainAdmin, or
    //          the Admin scoped to this query's place.
    // CREATE — authenticated user; firebaseUid must equal caller uid;
    //          status must start as 'open'.
    // UPDATE — MainAdmin or the scoped place Admin only (replying).
    // DELETE — never from the client.
    match /PlaceQueries/{queryId} {

      allow read:
        if isAuth()
        && (resource.data.firebaseUid == request.auth.uid
            || isMainAdmin()
            || isPlaceAdminFor(resource.data.placeId));

      allow create:
        if isAuth()
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.status == 'open';

      allow update:
        if isMainAdmin() || isPlaceAdminFor(resource.data.placeId);

      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────
    // Collection: Favorites
    // Document id = "{firebaseUid}_{placeId}" (deterministic — enforced on
    // create below so a tourist can only ever have one favorite doc per
    // place). Fields: firebaseUid, placeId, placeName, placeCoverImage,
    // cityId, cityName, createdAt.
    //
    // Pure owner-only collection, no admin workflow — toggling is a plain
    // create/delete from place_details_screen.dart / my_favorites_screen.dart.
    //
    // READ   — the owning tourist only.
    // CREATE — authenticated user; firebaseUid must equal caller uid; the
    //          doc id must match the deterministic uid_placeId scheme.
    // UPDATE — never (toggle is create/delete only).
    // DELETE — the owning tourist only.
    match /Favorites/{favoriteId} {

      allow read: if isAuth() && resource.data.firebaseUid == request.auth.uid;

      allow create:
        if isAuth()
        && request.resource.data.firebaseUid == request.auth.uid
        && favoriteId == request.auth.uid + '_' + request.resource.data.placeId;

      allow update: if false;

      allow delete:
        if isAuth() && resource.data.firebaseUid == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────────────────
    // Collection: ContactMessages
    // Document id = auto-generated. Fields: name, email, message, createdAt.
    //
    // Submitted from the landing page footer's "Contact Us" form — must work
    // for a signed-out visitor, so create is public rather than gated on
    // isAuth(). Field-shape + length validation stands in for auth here.
    // Reading messages back is a future admin-panel feature; for now they
    // just need to persist safely.
    //
    // READ/UPDATE/DELETE — MainAdmin only.
    // CREATE            — anyone, provided the shape is a genuine message.
    match /ContactMessages/{messageId} {

      allow read, update, delete: if isMainAdmin();

      allow create:
        if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000;
    }


    // ─────────────────────────────────────────────────────────────────────
    // Collection: AuditLog
    // Document id = auto-generated. Append-only trail written by
    // AuditLogService.log from every admin screen that mutates data
    // (fields: adminUid, adminEmail, action, module, targetId, targetLabel,
    // details, timestamp). Read by AdminAuditLogScreen (MainAdmin-only).
    //
    // READ         — MainAdmin only.
    // CREATE       — any admin role (the log records their own actions).
    // UPDATE/DELETE — never; the trail is append-only.
    match /AuditLog/{entryId} {
      allow read: if isMainAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

  }
}